{
  "schema": "dependabot-prep-policy:v3",
  "executionModel": "trusted-openclaw-agent",
  "operatingRevision": "autonomous-decisions-v1",
  "workflow": {
    "skill": "dependabot-prep",
    "revision": "trusted-agent-v1",
    "runtimes": ["openclaw", "codex", "claude"],
    "hostProfile": "giskard-capped-otherwise-portable-serial"
  },
  "repository": "mento-protocol/frontend-monorepo",
  "baseRef": "main",
  "canonicalPlaybook": "docs/dependabot-automation.md",
  "entryPrompt": "scripts/prompts/dependabot-weekly.md",
  "authority": {
    "source": "live-main",
    "candidateInstructions": "not-authority",
    "requireCurrentPolicyBeforeWrites": true
  },
  "admission": {
    "author": {
      "id": 49699333,
      "login": "dependabot[bot]",
      "type": "Bot"
    },
    "sameRepository": true,
    "headRefPrefix": "dependabot/",
    "openOnly": true,
    "drafts": "needs-decision-no-state-change",
    "autoMergeMustBeDisabled": true,
    "vetoLabels": [
      "dependencies:manual",
      "dependabot:manual",
      "do-not-merge",
      "no-auto-merge",
      "processor:veto"
    ],
    "unexplainedForeignCommits": "needs-decision"
  },
  "limits": {
    "activeBatches": 1,
    "batchMinutes": 360,
    "perPullRequestMinutes": 45,
    "repairAttempts": 3
  },
  "decisions": {
    "default": "best-supported-reversible-choice-and-continue",
    "uncertaintyAloneBlocks": false,
    "materialChoices": "maintained-pr-comment-with-evidence-risk-confidence-and-alternatives",
    "lowConfidence": "request-input-in-pr-comment-and-continue-safe-work",
    "consolidation": "only-proven-coupling-lowest-numbered-eligible-pr-keep-siblings-open",
    "explicitHoldsAndForbiddenActions": "never-override"
  },
  "reporting": {
    "slack": ["start", "actionable-exception", "final-report"],
    "periodicStatusMessages": false,
    "finalDelivery": "full-readable-report-not-local-path-only",
    "requireDeliveryReceipt": true,
    "prCommentMarker": "<!-- mento-dependabot-preparation:v1 -->"
  },
  "hostResources": {
    "heavyTrees": 1,
    "memoryHigh": "2G",
    "memoryMax": "3G",
    "memorySwapMax": 0,
    "cpuQuota": "100%",
    "turboConcurrency": 1,
    "vitestWorkers": 1,
    "hooks": "enabled-verify-effective-serialization"
  },
  "changes": {
    "allowed": [
      "dependency-source-repairs",
      "manifest-and-lockfile-updates",
      "documented-runtime-contract-updates",
      "focused-tests",
      "package-installation",
      "local-build-and-test",
      "merge-current-main",
      "request-current-head-review",
      "answer-review-feedback"
    ],
    "needsDecisionPaths": [
      ".github/workflows/**",
      ".github/actions/**",
      ".github/dependabot-prep-policy.json",
      "AGENTS.md",
      "CLAUDE.md",
      "docs/dependabot-automation.md",
      "scripts/prompts/dependabot-weekly.md"
    ],
    "needsDecisionTriggers": [
      "security-control-changes",
      "automation-policy-changes",
      "weakened-or-disabled-checks",
      "credential-or-permission-changes",
      "unexplained-history",
      "irreversible-or-out-of-scope-product-or-architecture-changes"
    ],
    "needsDecisionPublication": false,
    "majorOrRuntimeUpdate": "research-and-repair-with-documented-validation",
    "push": {
      "existingPullRequestBranchOnly": true,
      "fastForwardOnly": true,
      "explicitRefspec": true,
      "recheckRemoteHeadBeforePush": true,
      "lease": "exact-ref-and-observed-nonzero-sha",
      "proveFastForwardBeforeLease": true,
      "noOpPush": false
    }
  },
  "forbiddenActions": [
    "approve",
    "merge",
    "close",
    "mark-ready-for-review",
    "enable-auto-merge",
    "disable-auto-merge",
    "enqueue-merge",
    "dismiss-review",
    "resolve-thread",
    "unresolve-thread",
    "force-push",
    "rebase",
    "recreate",
    "rerun-checks",
    "publish-needs-decision-changes",
    "weaken-security-or-checks",
    "expose-secrets"
  ],
  "research": {
    "scope": "every-dependency-in-every-pull-request-including-manual",
    "tupleFields": ["name", "fromVersion", "toVersion"],
    "sources": [
      "upstream-release-notes",
      "upstream-changelog",
      "migration-guide",
      "security-advisory"
    ],
    "fallback": "verified-upstream-project-page-with-explicit-source-gaps",
    "requireLiveVerification": true,
    "reportFields": [
      "source-links",
      "breaking-changes",
      "repository-impact",
      "recommendation",
      "risk",
      "confidence",
      "confidence-rationale",
      "source-gaps"
    ],
    "unavailable": "blocked-and-operationally-incomplete"
  },
  "handoff": {
    "verdicts": ["ready-for-maintainer-decision", "needs-decision", "blocked"],
    "exactHeadAndBase": true,
    "containsCurrentMain": true,
    "mergeable": true,
    "autoMergeMustBeDisabled": true,
    "requiredChecks": "all-live-required-checks-with-authenticated-producers",
    "checkEvidence": "exact-head-app-or-status-creator-and-workflow-binding",
    "additionalChecks": "all-affected-repository-gates",
    "reviewer": {
      "id": 136622811,
      "login": "coderabbitai[bot]",
      "type": "Bot"
    },
    "reviewCommit": "exact-final-head",
    "feedback": "all-surfaces-including-walkthroughs-and-followups",
    "actionableFeedback": "address-and-answer-every-item",
    "disputedFeedback": "investigate-decide-and-answer-with-evidence-no-unproven-ready",
    "answeredUnresolvedThreads": "list-for-maintainer",
    "humanApprovalAndMerge": "maintainer-only",
    "recheckOnHeadOrBaseDrift": true
  },
  "security": {
    "dependabotCi": "secretless",
    "vercelCredentialedPreview": "forbidden",
    "githubActionsRefs": "full-lowercase-40-hex-sha",
    "osvScannerAndReporter": "same-revision",
    "checksAndSecurityControls": "never-weaken"
  }
}
