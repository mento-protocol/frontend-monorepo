# Find these in the vercel project settings: https://vercel.com/mentolabs/app.mento.org/settings/environment-variables
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_WALLET_CONNECT_ID=
NEXT_PUBLIC_SENTRY_DSN_SWAP=
# Required only for Vercel production source-map uploads.
SENTRY_AUTH_TOKEN=
CHAINALYSIS_API_KEY=
NEXT_PUBLIC_ENABLE_DEBUG="true"
# NEXT_PUBLIC_E2E_TEST=false

# Banner configuration (optional)
NEXT_PUBLIC_BANNER_TEXT=
NEXT_PUBLIC_BANNER_LINK=

# Trove-history subgraph (borrow activity panel). Optional — @repo/web3 falls
# back to the currently-deployed Subgraph Studio URLs when these are unset.
# Set them after a subgraph redeploy in mento-protocol/bold changes the Studio
# version label, or to move mainnet onto the decentralized-network gateway.
NEXT_PUBLIC_TROVES_SUBGRAPH_URL=
NEXT_PUBLIC_TROVES_SUBGRAPH_URL_CELO_SEPOLIA=
# Required only when a troves subgraph URL above points at gateway.thegraph.com.
NEXT_PUBLIC_GRAPH_API_KEY=
