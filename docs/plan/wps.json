{
  "version": 1,
  "project": "frontend-monorepo",
  "notes": [
    "Source of truth for the task DAG. Coordinator-owned: no task edits this file.",
    "A task may change only paths matching its `owned` globs, plus `alwaysAllowed`. `coordinatorOwned` always wins.",
    "`brief: null` means NOT DISPATCHABLE. Write docs/plan/briefs/<id>.md first, then set the path here.",
    "Keep `owned` globs disjoint between tasks that run at the same time; `skein plan` prints overlaps.",
    "money: true and pii: true make a cross-model review mandatory before merge. `done: true` is set by skein merge.",
    "Base branch is audit-main-app. The owner merges PRs by hand, and plan.mjs only detects merges on origin/main, so the coordinator sets `done: true` here after each merge."
  ],
  "modelPolicy": {
    "principle": "The defects that matter are found by cross-model review, whichever model wrote the code. The reviewer is where model strength has the most leverage.",
    "structure": "disjoint file ownership per brief; known-issue notes in briefs so nobody re-investigates; fix rounds resume the author session rather than starting a fresh agent"
  },
  "coordinatorOwned": [
    "AGENTS.md",
    "CLAUDE.md",
    ".skein/**",
    "scripts/**",
    "docs/plan/**",
    ".github/**",
    ".superset/**",
    ".trunk/**",
    "package.json",
    "apps/*/package.json",
    "packages/*/package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "knip.json",
    "osv-scanner.toml",
    "eslint.config.mjs",
    "apps/*/next.config.ts",
    "apps/*/.env.example",
    "packages/eslint-config/**",
    "packages/typescript-config/**",
    "packages/vitest-config/**",
    "packages/jazzicon/**"
  ],
  "alwaysAllowed": ["docs/adr/DRAFT-*.md"],
  "tasks": [
    {
      "id": "FM-01",
      "title": "Show the trove owner and offer management only to the owner",
      "type": "fix",
      "slug": "owner-aware-manage-trove",
      "brief": "docs/plan/briefs/FM-01.md",
      "owned": [
        "apps/app.mento.org/app/components/borrow/manage-trove/manage-trove-view.tsx",
        "apps/app.mento.org/app/components/borrow/manage-trove/manage-trove-view.test.tsx",
        "packages/web3/src/features/borrow/hooks/use-trove-owner.ts",
        "packages/web3/src/features/borrow/hooks/use-trove-owner.test.ts",
        "packages/web3/src/features/borrow/hooks/use-adjust-trove.ts",
        "packages/web3/src/features/borrow/hooks/index.ts"
      ],
      "accept": [
        "pnpm --filter app.mento.org exec vitest run app/components/borrow/manage-trove/manage-trove-view.test.tsx",
        "pnpm --filter @repo/web3 exec vitest run src/features/borrow/hooks/use-trove-owner.test.ts"
      ],
      "deps": [],
      "money": true,
      "pii": false,
      "done": true
    },
    {
      "id": "FM-02",
      "title": "Screen both bridge wallets before each transfer",
      "type": "fix",
      "slug": "bridge-transfer-screening",
      "brief": "docs/plan/briefs/FM-02.md",
      "owned": [
        "apps/app.mento.org/app/components/bridge/**",
        "apps/app.mento.org/e2e/disconnected.visual.spec.ts"
      ],
      "accept": [
        "pnpm --filter app.mento.org exec vitest run app/components/bridge",
        "grep -q \"validateTransferHandler: validateBridgeTransfer\" apps/app.mento.org/app/components/bridge/bridge-view.tsx",
        "git diff --quiet origin/audit-main-app...HEAD -- apps/app.mento.org/app/components/bridge/bridge-config.ts"
      ],
      "deps": [],
      "money": true,
      "pii": false
    },
    {
      "id": "FM-03",
      "title": "Report client errors to Sentry and stop sending personal data",
      "type": "fix",
      "slug": "sentry-errors-and-privacy",
      "brief": "docs/plan/briefs/FM-03.md",
      "owned": [
        "apps/app.mento.org/app/components/errors.tsx",
        "apps/app.mento.org/app/components/errors.test.tsx",
        "apps/app.mento.org/app/components/providers.tsx",
        "apps/app.mento.org/instrumentation-client.ts",
        "apps/app.mento.org/app/hooks/use-sentry-wallet-context.ts",
        "apps/app.mento.org/app/hooks/use-sentry-wallet-context.test.ts",
        "apps/app.mento.org/app/hooks/use-sentry-error-reporter.ts",
        "apps/app.mento.org/app/hooks/use-sentry-error-reporter.test.ts",
        "packages/web3/src/utils/error-reporter.ts",
        "packages/web3/src/utils/error-reporter.test.ts",
        "packages/web3/src/utils/index.ts",
        "packages/web3/src/features/tx-flow/engine.ts",
        "packages/web3/src/features/swap/hooks/use-swap-transaction.tsx",
        "packages/web3/src/features/swap/hooks/use-approve-transaction.tsx",
        "apps/app.mento.org/app/lib/sentry-redaction.ts",
        "apps/app.mento.org/app/lib/sentry-redaction.test.ts",
        "packages/web3/src/features/tx-flow/engine-report-error.test.ts"
      ],
      "accept": [
        "pnpm --filter app.mento.org exec vitest run app/components/errors.test.tsx app/hooks/use-sentry-wallet-context.test.ts app/hooks/use-sentry-error-reporter.test.ts app/lib/sentry-redaction.test.ts",
        "pnpm --filter @repo/web3 exec vitest run src/utils/error-reporter.test.ts src/features/tx-flow/engine-report-error.test.ts",
        "! grep -n \"sendDefaultPii: true\" apps/app.mento.org/instrumentation-client.ts",
        "! grep -nE \"maskAllText: false|maskAllInputs: false|blockAllMedia: false\" apps/app.mento.org/instrumentation-client.ts",
        "grep -q \"beforeBreadcrumb\" apps/app.mento.org/instrumentation-client.ts",
        "grep -q \"beforeAddRecordingEvent\" apps/app.mento.org/instrumentation-client.ts"
      ],
      "deps": [],
      "money": false,
      "pii": true,
      "done": true
    }
  ]
}
